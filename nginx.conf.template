daemon off;
worker_processes 2;
pid /run/nginx/nginx.pid;
error_log stderr warn;

events {
    worker_connections 1024;
}

http {
    access_log off;
    server_tokens off;

    client_body_temp_path /run/nginx/client_body;
    proxy_temp_path /run/nginx/proxy;
    fastcgi_temp_path /run/nginx/fastcgi;
    uwsgi_temp_path /run/nginx/uwsgi;
    scgi_temp_path /run/nginx/scgi;

    client_max_body_size 0;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }

    # The Cloudron reverse proxy and health checker (see start.sh)
    geo $from_platform {
        default 0;
##PLATFORM_IPS##
    }

    map $from_platform $upstream_authorization {
        1       "##PLATFORM_AUTHORIZATION##";
        default $http_authorization;
    }

    server {
        listen 8000 default_server;

        # Succeeds only when the API answers an authenticated query that reads the database. The
        # upstream response stays internal, so the endpoint reveals nothing but up or down.
        location = /healthcheck {
            auth_request /_healthcheck_upstream;
            default_type text/plain;
            alias /app/code/healthcheck.txt;
        }

        location = /_healthcheck_upstream {
            internal;
            proxy_pass http://127.0.0.1:##OPENCODE_PORT##/api/session?limit=1;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Authorization "##BASIC_AUTH##";
            proxy_read_timeout 10s;
        }

        location / {
            proxy_pass http://127.0.0.1:##OPENCODE_PORT##;
            proxy_http_version 1.1;

            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Authorization $upstream_authorization;

            # Event streams and terminals stay open
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;
            proxy_read_timeout 1d;
            proxy_send_timeout 1d;
        }
    }
}
