# Environment for OpenCode. Every variable set here is exported to the server, its tools and the
# web terminal. Restart the app after editing.
#
# Provider keys can be set here instead of signing in from the web UI:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
#
# Git identity for commits the agent makes:
# GIT_AUTHOR_NAME="OpenCode"
# GIT_AUTHOR_EMAIL="opencode@example.com"
# GIT_COMMITTER_NAME="${GIT_AUTHOR_NAME}"
# GIT_COMMITTER_EMAIL="${GIT_AUTHOR_EMAIL}"
